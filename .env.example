# Provider credentials for deployment. Never put secrets in VITE_ variables.
# Backend environment and database credentials live on the droplet.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Real payments require both Stripe secrets, and a saved account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional per-stage platform budget for public-search embeddings ($0.25/day).
# SEARCH_DAILY_BUDGET_NANOS=250000000
# Cloud dev serves authenticated API/MCP only; its UI runs on localhost.
# UI_ORIGIN=http://localhost:7330
