{
  "name": "new-drugs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "icons:catalog": "node scripts/icons.mjs --write",
    "dev": "node scripts/cloud-dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:admin": "vite --config admin/vite.config.ts --host 127.0.0.1",
    "deploy:dev": "node scripts/deploy.mjs dev",
    "deploy:prod": "node scripts/deploy.mjs prod",
    "build": "node scripts/version.mjs && tsc --noEmit && vite build && vite build --config admin/vite.config.ts && tsup server/index.ts server/mediaMigration.ts server/workerStatus.ts --target node22 --format esm --out-dir dist/server --external vite && tsup cli/index.ts --format esm --out-dir dist/cli && node scripts/package-cli.mjs",
    "start": "NODE_ENV=production node dist/server/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx cli/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@js-temporal/polyfill": "0.5.1",
    "@livekit/protocol": "1.50.4",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@napi-rs/canvas": "1.0.9",
    "@phosphor-icons/core": "2.1.1",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-virtual": "3.14.13",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "h3-js": "4.5.0",
    "helmet": "8.3.0",
    "hnswlib-node": "3.0.0",
    "html-squircle": "4.1.2",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "linkify-it": "6.1.0",
    "livekit-client": "2.21.0",
    "livekit-server-sdk": "2.19.1",
    "mongodb": "7.6.0",
    "openai": "7.23.0",
    "pdf-parse": "2.4.5",
    "photoswipe": "5.4.4",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.4",
    "stripe": "22.6.2",
    "tlds": "1.261.0",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
