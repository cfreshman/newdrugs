# LiveKit v1.13.7. Copy to /etc/newdrugs/livekit-dev.yaml and substitute
# private credentials. Keep that file mode 600 and out of the repository.
port: 7880
log_level: info
rtc:
  node_ip: 167.172.21.42
  use_external_ip: false
  tcp_port: 7881
  udp_port: 7882
keys:
  "REPLACE_API_KEY": "REPLACE_API_SECRET"
turn:
  enabled: true
  domain: dev.druggie.org
  udp_port: 3478
  tls_port: 5349
  cert_file: /etc/letsencrypt/live/druggie.org/fullchain.pem
  key_file: /etc/letsencrypt/live/druggie.org/privkey.pem
webhook:
  api_key: "REPLACE_API_KEY"
  urls:
    - http://127.0.0.1:7333/api/livekit/webhook
